import "@tangram-app-manifest/manifest.pkl" as manifest

secrets: List<manifest.ConfigField> = List(
  new manifest.ConfigField {
    name        = "user"
    required    = true
    description = "ClickHouse user with privileges on the target instance."
  },
  new manifest.ConfigField {
    name        = "password"
    required    = true
    description = "Password for the above ClickHouse user."
  }
)
