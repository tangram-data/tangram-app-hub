import "@tangram-app-manifest/manifest.pkl" as manifest

secrets: List<manifest.ConfigField> = List(
  new manifest.ConfigField {
    name        = "gitUser"
    required    = true
    description = "Git username for cloning the DAGs repository."
  },
  new manifest.ConfigField {
    name        = "gitPassword"
    required    = true
    description = "Git password or PAT for cloning the DAGs repository."
  },
  new manifest.ConfigField {
    name        = "fernetKey"
    required    = true
    description = "Fernet key for encrypting Airflow connection passwords. Generate with: python -c \"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\""
  },
  new manifest.ConfigField {
    name        = "apiSecretKey"
    required    = true
    description = "Secret key for internal API authentication. Generate with: openssl rand -hex 32"
  }
)
