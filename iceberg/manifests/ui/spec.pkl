import "@tangram-app-manifest/ui.pkl" as ui

logo = "static/logo.png"

// The app serves its own UI (tangram-iceberg/ui, bundled into the catalog server), not an OS built-in one.
// Requests matching an api/open_api.yml operation go through IAM as API calls; everything else is UI, so
// every server API path must stay declared there.
uiPattern = new ui.UriPattern {
  pattern = ".*"
}

deployment: ui.UIDeployment = new {
  mode = "Proxy"
  uriPatterns = List(uiPattern)
}

resourceTypeIcons {
  ["Catalog"]  = "static/logo.png"
  ["Database"] = "static/logo.png"
  ["Table"]    = "static/logo.png"
  ["View"]     = "static/logo.png"
}

resourceTypeUri {
  ["Database"] = "/databases/{{names[1]}}"
  ["Table"]    = "/databases/{{names[1]}}/tables/{{names[2]}}"
  ["View"]     = "/databases/{{names[1]}}/views/{{names[2]}}"
}

components: Listing<ui.AppUIComponentSpec> = new Listing {
  new ui.AppUIComponentSpec {
    name        = "db-list"
    kind        = "sandboxed"
    description = "List Iceberg databases in the catalog"
    entry       = "components/db-list/db-list.tsx"
    spec = new ui.UIComponentContract {
      title = "Iceberg databases"
      inputs {
        type = "object"
        properties {}
      }
      outputs {
        new ui.UIComponentOutput {
          name = "select"
          payload {
            type = "object"
            required { "database" }
            properties {
              ["database"] = new Dynamic { type = "string" }
            }
          }
        }
      }
    }
    surfaces { "chat"; "dashboard"; "app-page" }
  }
}
