import "@tangram-app-manifest/manifest.pkl" as manifest

secrets: List<manifest.ConfigField> = List(
  new manifest.ConfigField {
    name        = "user"
    required    = true
    description = "Snowflake username with admin permissions on the target account."
  },
  new manifest.ConfigField {
    name        = "password"
    required    = true
    description = "Snowflake PAT token for the above user. Used as the password in JDBC connections."
  }
)
