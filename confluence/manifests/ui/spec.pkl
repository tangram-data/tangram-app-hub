import "@tangram-app-manifest/ui.pkl" as ui
logo = "static/confluence.png"

deployment: ui.UIDeployment = new {
  mode = "None"
}

// Connector identity implies no local workload; components are UI declarations.
components: Listing<ui.AppUIComponentSpec> = new Listing {
  new ui.AppUIComponentSpec {
    name = "page-viewer"
    kind = "sandboxed"
    entry = "components/page-viewer/page-viewer.tsx"
    spec = new ui.UIComponentContract {
      title = "Confluence page"
      description = "Render a Confluence page as it reads in Confluence: space and parent breadcrumb, title, last-updated line, and the body (headings, lists, tables, code and info/note/warning panels; other macros show as labels). Footer comments are listed, and the user can add one (posted as them after confirmation)."
      inputs {
        type = "object"
        required {
          "pageId"
        }
        properties {
          ["pageId"] = new Dynamic {
            type = "string"
            description = "Numeric Confluence page id, e.g. from confluence_search_content (content.id) or confluence_list_page."
          }
        }
      }
    }
    surfaces { "chat"; "app-page" }
  }
  new ui.AppUIComponentSpec {
    name = "page-composer"
    kind = "sandboxed"
    entry = "components/page-composer/page-composer.tsx"
    spec = new ui.UIComponentContract {
      title = "Confluence page composer"
      description = "Markdown-style Confluence composer with a live preview. New page: write it in a space (optionally under a parent). Existing page (pageId): by default append a section at the end — the page's current content is sent back exactly as it is, so nothing can be lost; 'Edit whole page' is offered only when the page converts to markdown without loss (otherwise the user appends or opens Confluence). Markdown: #, ##, ### headings, - bullets, 1. lists, > quotes, --- rules, ``` code fences; **bold**, *italic*, `code` inline. The user edits and confirms before anything is saved."
      inputs {
        type = "object"
        properties {
          ["spaceId"] = new Dynamic {
            type = "string"
            description = "Numeric space id for a new page; without it the user picks a space."
          }
          ["parentId"] = new Dynamic {
            type = "string"
            description = "Parent page id for a new page; omit for the space root."
          }
          ["pageId"] = new Dynamic {
            type = "string"
            description = "Set to work on an existing page (append a section by default)."
          }
          ["append"] = new Dynamic {
            type = "boolean"
            description = "Existing pages only. true (default): body is a section appended to the page. false: body replaces the whole page — honoured only when the page converts to markdown without loss, else the composer falls back to appending."
          }
          ["title"] = new Dynamic {
            type = "string"
            description = "Page title."
          }
          ["body"] = new Dynamic {
            type = "string"
            description = "Markdown draft (see description): the new page's content, the section to append, or — with append=false — the whole page body."
          }
        }
      }
      outputs {
        new ui.UIComponentOutput {
          name = "saved"
          payload {
            type = "object"
            properties {
              ["pageId"] = new Dynamic { type = "string" }
              ["title"] = new Dynamic { type = "string" }
              ["url"] = new Dynamic { type = "string" }
            }
          }
        }
      }
    }
    surfaces { "chat"; "app-page" }
  }
}
