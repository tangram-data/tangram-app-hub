import "@tangram-app-manifest/manifest.pkl" as manifest

settings: List<manifest.ConfigField> = List(
  new manifest.ConfigField {
    name        = "siteUrl"
    required    = true
    description = "Your Confluence Cloud site URL. Every connection acts on this site; connecting fails for accounts without access to it."
    example     = "https://acme.atlassian.net"
  }
)
