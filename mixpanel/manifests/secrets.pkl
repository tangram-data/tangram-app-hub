import "@tangram-app-manifest/manifest.pkl" as manifest

secrets: List<manifest.ConfigField> = List(
  new manifest.ConfigField {
    name        = "mixpanelServiceAccountUsername"
    required    = true
    description = "Mixpanel service account username (Organization Settings → Service Accounts), e.g. tangram.1a2b3c.mp-service-account."
  },
  new manifest.ConfigField {
    name        = "mixpanelServiceAccountSecret"
    required    = true
    description = "The service account's secret (shown once at creation). Every call runs with this account's project roles — prefer Analyst on only the projects Tangram should see."
  }
)
