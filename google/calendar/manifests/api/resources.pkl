import "@tangram-app-manifest/resources.pkl" as resources

types: List<resources.ResourceTypeDefinition> = List(
  new resources.ResourceTypeDefinition {
    name = "Calendar"
    activeVersion = "v1"
    doc = "A calendar on the connected account's calendar list."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List the account's calendars; ids feed the calendarId of event operations (or use \"primary\")."
          openApiMapping = new resources.OpenApiMapping { operationId = "listCalendars" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "List calendars through the Google Calendar connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Event"
    activeVersion = "v1"
    doc = "An event on one of the connected account's calendars."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List or search events on a calendar; supports free-text q, a timeMin/timeMax window, and singleEvents+orderBy=startTime for agenda order."
          openApiMapping = new resources.OpenApiMapping { operationId = "listEvents" }
        },
        new resources.Action {
          name = "Get"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Fetch a single event, including times, attendees, and description, by calendarId and eventId."
          openApiMapping = new resources.OpenApiMapping { operationId = "getEvent" }
        },
        new resources.Action {
          name = "ListInstances"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List the occurrences of a recurring event (eventId = the parent with recurrence) within an optional timeMin/timeMax window. Each instance has its own id, so Update/Delete on it changes just that occurrence."
          openApiMapping = new resources.OpenApiMapping { operationId = "listEventInstances" }
        },
        new resources.Action {
          name = "QuickAdd"
          privilege = "Create"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Create an event from one sentence, e.g. \"Lunch with Ana at Cafe Roma tomorrow 12pm-1pm\" (parsed in the calendar's time zone). Check the returned start/end. Confirmation-gated: email addresses in the text can become attendees, and sendUpdates=all invites them."
          openApiMapping = new resources.OpenApiMapping { operationId = "quickAddEvent" }
        },
        new resources.Action {
          name = "Create"
          privilege = "Create"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Create an event. start/end each take {date} (all-day, end exclusive) or {dateTime,timeZone}; sendUpdates=all emails invitations to attendees (default none)."
          openApiMapping = new resources.OpenApiMapping { operationId = "createEvent" }
        },
        new resources.Action {
          name = "Update"
          privilege = "Write"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Patch fields of an existing event (only the fields in the body change); attendees replaces the whole list, so Get first and send the merged list. To RSVP, Get the event, set responseStatus (accepted/declined/tentative) on your own attendee entry only, and send the full attendees list. sendUpdates=all notifies attendees (default none). Confirmation-gated: it can invite people and reschedule shared meetings."
          openApiMapping = new resources.OpenApiMapping { operationId = "updateEvent" }
        },
        new resources.Action {
          name = "Delete"
          privilege = "Delete"
          effect = "Irreversible"
          idempotent = true
          requiresConfirmation = true
          doc = "Delete an event; sendUpdates=all sends cancellation emails to attendees (default none)."
          openApiMapping = new resources.OpenApiMapping { operationId = "deleteEvent" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read", "Create", "Write", "Delete")
        description = "Read and manage events through the Google Calendar connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "FreeBusy"
    activeVersion = "v1"
    doc = "Busy/free availability information for the connected account's calendars."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "Query"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Query busy intervals for one or more calendars over a timeMin/timeMax window — use to find open slots before scheduling."
          openApiMapping = new resources.OpenApiMapping { operationId = "queryFreeBusy" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "Check availability through the Google Calendar connector."
      })
    })
  }
)
