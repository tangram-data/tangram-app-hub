import "@tangram-app-manifest/resources.pkl" as resources

types: List<resources.ResourceTypeDefinition> = List(
  new resources.ResourceTypeDefinition {
    name = "Spreadsheet"
    activeVersion = "v1"
    doc = "A Google Sheets spreadsheet accessible to the connected account."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "Create"
          privilege = "Create"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = false
          doc = "Create a new spreadsheet with a title; returns its spreadsheetId and URL."
          openApiMapping = new resources.OpenApiMapping { operationId = "createSpreadsheet" }
        },
        new resources.Action {
          name = "Get"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Fetch spreadsheet metadata: sheet names, ids, and dimensions."
          openApiMapping = new resources.OpenApiMapping { operationId = "getSpreadsheet" }
        },
        new resources.Action {
          name = "ReadValues"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Read cell values from a range in A1 notation (e.g. Sheet1!A1:D10)."
          openApiMapping = new resources.OpenApiMapping { operationId = "getValues" }
        },
        new resources.Action {
          name = "BatchReadValues"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Read several A1 ranges in one call (ranges, e.g. [\"Sheet1!A1:D10\", \"Summary!B2:B5\"]); returns valueRanges in request order."
          openApiMapping = new resources.OpenApiMapping { operationId = "batchGetValues" }
        },
        new resources.Action {
          name = "UpdateValues"
          privilege = "Write"
          effect = "Reversible"
          idempotent = true
          requiresConfirmation = true
          doc = "Overwrite cell values in a range. Existing values in the range are replaced."
          openApiMapping = new resources.OpenApiMapping { operationId = "updateValues" }
        },
        new resources.Action {
          name = "AppendValues"
          privilege = "Write"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = false
          doc = "Append rows after the last row of the table that contains the given range."
          openApiMapping = new resources.OpenApiMapping { operationId = "appendValues" }
        },
        new resources.Action {
          name = "ClearValues"
          privilege = "Write"
          effect = "Irreversible"
          idempotent = true
          requiresConfirmation = true
          doc = "Clear all values in an A1 range (formatting is kept). The old values are not recoverable through this connector."
          openApiMapping = new resources.OpenApiMapping { operationId = "clearValues" }
        },
        new resources.Action {
          name = "BatchUpdate"
          privilege = "Write"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Apply Sheets API structural/formatting requests atomically, e.g. requests [{\"addSheet\": {\"properties\": {\"title\": \"Q3\"}}}] or [{\"updateSheetProperties\": {\"properties\": {\"sheetId\": 0, \"title\": \"Summary\"}, \"fields\": \"title\"}}]. sheetId comes from sheets_get_spreadsheet. Confirmation-gated: requests like deleteSheet remove data."
          openApiMapping = new resources.OpenApiMapping { operationId = "batchUpdateSpreadsheet" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read", "Create", "Write")
        description = "Create spreadsheets and read/write cell values through the Sheets connector."
      })
    })
  }
)
