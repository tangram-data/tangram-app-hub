import "@tangram-app-manifest/manifest.pkl" as manifest
import "@tangram-app-manifest/resources.pkl" as resources
import "../app.pkl" as app

local appRef = new manifest.AppName { group = app.group; name = app.name }
local KafkaClusterType = new resources.ResourceType { app = appRef; name = "KafkaCluster" }

local Stateless = resources.Effect.Stateless
local Reversible = resources.Effect.Reversible
local Irreversible = resources.Effect.Irreversible

// ---------------------------------------------------------------------------
// KafkaCluster  (workspace-scoped)
// ---------------------------------------------------------------------------

KafkaCluster = new resources.ResourceTypeDefinition {
  name = "KafkaCluster"
  doc  = "Strimzi-managed Apache Kafka cluster (KRaft) on Kubernetes"
  activeVersion = "v1"
  scopeType = resources.WORKSPACE_TYPE
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"; served = true
    actions = List(
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Initialize the workspace's single Kafka cluster (asynchronous, fixed name)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "initializeKafkaCluster"
          resourceNameTemplate = "[kafka]"
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Get a Kafka cluster by name, including lifecycle status."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Decommission a Kafka cluster (asynchronous): topics, users, node pools, brokers and their disks."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteKafkaCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Scale"
        effect = Reversible
        idempotent = true
        doc = "Update the broker replica count (scale-down requires Cruise Control)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "scaleKafkaCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Configure"
        effect = Reversible
        idempotent = true
        doc = "Update per-pod resources of the controller/broker pools and the broker replica count."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "configureKafkaCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetEndpoints"
        effect = Stateless
        idempotent = true
        doc = "Internal and external bootstrap servers of the cluster."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaClusterEndpoints"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetInstances"
        effect = Stateless
        idempotent = true
        doc = "Status of the cluster's controller, broker and entity-operator pods."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaClusterInstances"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetInstanceLogs"
        effect = Stateless
        idempotent = true
        doc = "Tail of one pod's logs (debugging aid)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaClusterInstanceLogs"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetConnectionDetails"
        effect = Stateless
        idempotent = true
        doc = "Bootstrap servers and admin SCRAM credentials for connecting clients."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaClusterConnectionDetails"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      }
    )
  })
}

// ---------------------------------------------------------------------------
// Topic  (KafkaCluster-scoped)
// ---------------------------------------------------------------------------

Topic = new resources.ResourceTypeDefinition {
  name = "Topic"
  doc  = "A Kafka topic, managed declaratively through a Strimzi KafkaTopic resource."
  activeVersion = "v1"
  scopeType = KafkaClusterType
  superType = resources.DATASET_TYPE
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"; served = true
    // Grantable per-topic roles; bound to consumers such as the per-job service accounts that
    // StarRocks routine loads provision for the token listener.
    presetRoles = List(
      new resources.Role {
        name = "reader"
        permissions = List("Read")
        description = "Consume messages from the topic."
      },
      new resources.Role {
        name = "writer"
        permissions = List("Read", "Write")
        description = "Produce to and consume from the topic."
      }
    )
    actions = List(
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Creates a topic with partitions, replicas and config."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "createKafkaTopic"
          resourceNameTemplate = "[{{parameters.name}}, {{requestBody.name}}]"
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Describe one topic (partitions, replicas, config, readiness)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaTopic"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.topic}}]"
        }
      },
      new resources.Action {
        name = "List"
        effect = Stateless
        idempotent = true
        doc = "List the cluster's topics with their reconciliation state."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listKafkaTopics"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Configure"
        effect = Reversible
        idempotent = true
        doc = "Update a topic's partition count (grow-only) and/or config."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "updateKafkaTopic"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.topic}}]"
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete a topic and its data. Cannot be undone."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteKafkaTopic"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.topic}}]"
        }
      },
      new resources.Action {
        name = "Read"
        effect = Stateless
        idempotent = true
        doc = "Authorization marker for consuming from the topic."
      },
      new resources.Action {
        name = "Write"
        effect = Reversible
        idempotent = false
        doc = "Produce to the topic: post a single JSON message through the app's admin producer. Also the authorization marker for producing with Kafka clients."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "produceKafkaTopicMessage"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.topic}}]"
        }
      },
      new resources.Action {
        name = "SetSchema"
        effect = Reversible
        idempotent = false
        doc = "Create or update the topic's Tangram schema (the declared shape of its JSON messages), saved as a dataset schema in the core data catalog."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "setKafkaTopicSchema"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.topic}}]"
        }
      },
      new resources.Action {
        name = "GetSchema"
        effect = Stateless
        idempotent = true
        doc = "Latest registered Tangram schema of the topic."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaTopicSchema"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.topic}}]"
        }
      },
      new resources.Action {
        name = "GetStats"
        effect = Stateless
        idempotent = true
        doc = "Live per-partition offsets, retained-record estimate and log sizes, fetched from the brokers."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaTopicStats"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.topic}}]"
        }
      }
    )
  })
}

// ---------------------------------------------------------------------------
// IcebergSink  (KafkaCluster-scoped)
// ---------------------------------------------------------------------------

IcebergSink = new resources.ResourceTypeDefinition {
  name = "IcebergSink"
  doc  = "A managed Kafka Connect job continuously committing topics into a table of the workspace's Tangram Iceberg catalog, running as a per-job IAM service account."
  activeVersion = "v1"
  scopeType = KafkaClusterType
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"; served = true
    actions = List(
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Create an Iceberg sink job (asynchronous). A user-supplied customImage MUST be one the caller built or fully trusts — it runs inside the app namespace with access to the job's credentials."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "createKafkaIcebergSink"
          resourceNameTemplate = "[{{parameters.name}}, {{requestBody.name}}]"
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Describe one Iceberg sink job, including its live connector tasks."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getKafkaIcebergSink"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.sink}}]"
        }
      },
      new resources.Action {
        name = "List"
        effect = Stateless
        idempotent = true
        doc = "List the cluster's Iceberg sink jobs with their live Connect state."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listKafkaIcebergSinks"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Pause"
        effect = Reversible
        idempotent = true
        doc = "Pause the sink's connector (consumption and commits stop; state is kept)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "pauseKafkaIcebergSink"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.sink}}]"
        }
      },
      new resources.Action {
        name = "Resume"
        effect = Reversible
        idempotent = true
        doc = "Resume a paused sink connector."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "resumeKafkaIcebergSink"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.sink}}]"
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete the sink job (asynchronous): Connect resources, secrets, per-job service account and internal topics. Already-committed Iceberg data is kept."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteKafkaIcebergSink"
          resourceNameTemplate = "[{{parameters.name}}, {{parameters.sink}}]"
        }
      }
    )
  })
}

types: List<resources.ResourceTypeDefinition> = List(
  KafkaCluster, Topic, IcebergSink
)
