import "@tangram-app-manifest/api.pkl" as api

// The concrete Kubernetes Service inside the App's derived installation namespace that implements
// this API (produced by the kafka-service component's AppComponentServiceSpec).
backend: api.ServiceBackend = new api.ServiceBackend {
  serviceName = "kafka-service"
  port = 9899
}

authMode = "Proxy"
apiSpecFile = "open-api.yml"
