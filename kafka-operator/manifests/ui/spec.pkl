import "@tangram-app-manifest/ui.pkl" as ui

// Official Strimzi icon (CNCF artwork): the app is the Strimzi operator experience. The
// KafkaCluster resource keeps the Kafka mark — the resource is a Kafka cluster.
logo = "static/strimzi.svg"

uiPattern = new ui.UriPattern {
  pattern = ".*"
}

deployment: ui.UIDeployment = new {
  mode = "Proxy"
  uriPatterns = List(uiPattern)
}

resourceTypeIcons {
  ["KafkaCluster"] = "static/kafka.svg"
  ["Topic"] = "static/kafka.svg"
}
resourceTypeUri {
  ["KafkaCluster"] = "/clusters/{{names[1]}}"
  ["Topic"] = "/topics/{{names[2]}}"
}
