import "@tangram-app-manifest/ui.pkl" as ui

// The app is the Kafka operator experience, so it carries the Kafka mark (Strimzi is the
// implementation detail).
logo = "static/kafka.svg"

uiPattern = new ui.UriPattern {
  pattern = ".*"
}

deployment: ui.UIDeployment = new {
  mode = "Proxy"
  uriPatterns = List(uiPattern)
}

resourceTypeIcons {
  ["KafkaCluster"] = "static/kafka.svg"
  ["Topic"] = "static/kafka.svg"
}
resourceTypeUri {
  ["KafkaCluster"] = "/clusters/{{names[1]}}"
  ["Topic"] = "/topics/{{names[2]}}"
}
