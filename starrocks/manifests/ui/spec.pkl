import "@tangram-app-manifest/ui.pkl" as ui

logo = "static/starrocks.svg"

uiPattern = new ui.UriPattern {
  pattern = ".*"
}

deployment: ui.UIDeployment = new {
  mode = "Proxy"
  uriPatterns = List(uiPattern)
}

resourceTypeIcons {
  ["StarRocksCluster"] = "static/starrocks.svg"
  ["RoutineLoad"] = "static/starrocks.svg"
}
resourceTypeUri {
  ["StarRocksCluster"] = "/clusters/{{names[1]}}"
  // RoutineLoad names = [workspace, database, job]; the ingestion section lists all jobs.
  ["RoutineLoad"] = "/?section=ingestion"
}
