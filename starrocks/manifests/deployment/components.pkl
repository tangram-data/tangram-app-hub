import "dependencies.pkl" as deps
import "@tangram-app-manifest/deployment.pkl" as deployment
import "@tangram-app-manifest/deployment-runtime.pkl" as deploymentRuntime

local database = deps.databaseClaim.database()
local dbSecrets = deps.databaseClaim.secrets()
local bucket = deps.bucketClaim.bucket()
local bucketSecrets = deps.bucketClaim.secrets()

@deployment.AppComponentMeta {
  name = "starrocks-service"
  recommendedReplica = 1
  containers = List(new deployment.ContainerMeta {
    name = "starrocks-server"
    image = "ghcr.io/tangram-data/tangram-starrocks-server:1.0.6"
  })
  observability = new deployment.ComponentObservability {
    traces = "otlp"
    metrics = new deployment.OtlpMetrics {}
  }
}
starRocksManager: deployment.AppComponentSpec = new deployment.AppComponentSpec {
  service = new deployment.AppComponentServiceSpec {
    port = 9899
    targetPort = 9899
    protocol = "TCP"
  }
  containers = List(
    new deployment.AppContainerSpec {
      ports = List(9899)
      variables = Map(
        "SERVER_PORT", "9899",
        "TANGRAM_DATA_OS_WORKSPACE", deploymentRuntime.context.workspace,
        "K8S_NAMESPACE", deploymentRuntime.context.k8sNamespace,
        "TANGRAM_CORE_SERVICE_URI", deploymentRuntime.context.tangramOSPublicUrl,
        "STARROCKS_APP_JDBC_URL", "jdbc:postgresql://\(database.host):\(database.port)/\(database.name)",
        "STARROCKS_APP_JDBC_USER", dbSecrets.user,
        "STARROCKS_APP_JDBC_PASSWORD", new deployment.SecretValue {
          value = dbSecrets.password
        },
        // Provisioned shared-data bucket (type drives the StarRocks storage-volume config).
        "STARROCKS_BUCKET_TYPE", bucket.type,
        "STARROCKS_BUCKET_NAME", bucket.name,
        "STARROCKS_BUCKET_REGION", bucket.region ?? "",
        "STARROCKS_BUCKET_ENDPOINT", bucket.endpoint ?? "",
        "STARROCKS_BUCKET_PORT", "\(bucket.port ?? 0)",
        "STARROCKS_BUCKET_SECURED", "\(bucket.securedConnection ?? false)",
        "STARROCKS_BUCKET_ACCESS_KEY", new deployment.SecretValue {
          value = bucketSecrets.accessKey
        },
        "STARROCKS_BUCKET_SECRET_KEY", new deployment.SecretValue {
          value = bucketSecrets.secretKey ?? ""
        }
      )
    }
  )
}
