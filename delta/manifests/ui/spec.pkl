import "@tangram-app-manifest/ui.pkl" as ui

logo = "static/delta.svg"

// The app serves its own UI (tangram-delta/ui, bundled into the catalog server), not an OS built-in one.
uiPattern = new ui.UriPattern {
  pattern = ".*"
}

deployment: ui.UIDeployment = new {
  mode = "Proxy"
  uriPatterns = List(uiPattern)
}

resourceTypeIcons {
  ["Catalog"]  = "static/delta.svg"
  ["Database"] = "static/delta.svg"
  ["Table"]    = "static/delta.svg"
}

resourceTypeUri {
  ["Database"] = "/databases/{{names[1]}}"
  ["Table"]    = "/databases/{{names[1]}}/tables/{{names[2]}}"
}
