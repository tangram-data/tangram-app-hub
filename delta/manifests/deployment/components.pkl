import "../app.pkl" as app
import "dependencies.pkl" as deps
import "@tangram-app-manifest/deployment.pkl" as deployment
import "@tangram-app-manifest/deployment-runtime.pkl" as deploymentRuntime

local database = deps.postgresDb.database()
local dbSecrets = deps.postgresDb.secrets()
local storageBucket = deps.storageBucketClaim.bucket()

@deployment.AppComponentMeta {
  name = "catalog-service"
  recommendedReplica = 2
  containers = List(new deployment.ContainerMeta {
    name = "catalog-server"
    image = "ghcr.io/tangram-data/tangram-delta-catalog:0.1.0"
  })
}

catalogService: deployment.AppComponentSpec = new deployment.AppComponentSpec {
  service = new deployment.AppComponentServiceSpec {
    port = 9494
    targetPort = 9494
    protocol = "TCP"
  }
  containers = List(
    new deployment.AppContainerSpec {
      ports = List(9494)
      variables = Map(
        "TANGRAM_DATA_OS_WORKSPACE", deploymentRuntime.context.workspace,
        "DELTA_STORAGE_BUCKET", storageBucket.name,
        "DELTA_JDBC_URL", "jdbc:postgresql://\(database.host):\(database.port)/\(database.name)",
        "DELTA_JDBC_USER", dbSecrets.user,
        "DELTA_JDBC_PASSWORD",
        new deployment.SecretValue {
          value = dbSecrets.password
        }
      )
    }
  )
}
