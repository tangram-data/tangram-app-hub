import "@tangram-app-manifest/manifest.pkl" as manifest

secrets: List<manifest.ConfigField> = List(
  new manifest.ConfigField {
    name        = "datadogApiKey"
    required    = true
    description = "Datadog API key (Organization Settings → API Keys)."
  },
  new manifest.ConfigField {
    name        = "datadogApplicationKey"
    required    = true
    description = "Datadog application key (Organization Settings → Application Keys). Every call runs with this key's permissions — prefer a scoped key (see README)."
  }
)
