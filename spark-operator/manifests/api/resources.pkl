import "@tangram-app-manifest/resources.pkl" as resources

local Stateless = resources.Effect.Stateless
local Reversible = resources.Effect.Reversible
local Irreversible = resources.Effect.Irreversible

// ---------------------------------------------------------------------------
// SparkCluster (workspace-scoped): a Spark Connect server (driver) with on-demand executor pods, in
// the app's own namespace on the platform cluster.
// ---------------------------------------------------------------------------

SparkCluster = new resources.ResourceTypeDefinition {
  name = "SparkCluster"
  doc  = "Apache Spark cluster on the platform's Kubernetes: a Spark Connect driver with on-demand executors"
  activeVersion = "v1"
  scopeType = resources.WORKSPACE_TYPE
  // A SQL engine: the core server registers each cluster as one and the SQL proxy reaches it over
  // Spark Connect through GetConnectionDetails.
  superType = resources.SQL_ENGINE_TYPE
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"; served = true; superTypeVersion = "v1"
    // Grantable per-cluster roles (same shape as the Iceberg app's maintainer / viewer; no owner preset —
    // initializing and decommissioning stay with the workspace admin).
    presetRoles = List(
      new resources.Role {
        name = "maintainer"
        permissions = List(
          "Get", "List", "Configure", "Stop", "Start", "GetEndpoints", "GetInstances", "GetInstanceLogs", "GetConnectionDetails"
        )
        description = "Configure sizing and auto-stop, stop and start, inspect pods and logs. Cannot initialize or decommission the cluster."
      },
      new resources.Role {
        name = "viewer"
        permissions = List("Get", "List", "GetEndpoints", "GetInstances", "GetConnectionDetails")
        description = "Read-only — see the cluster, its endpoints and pods, and query it through the SQL proxy."
      }
    )
    actions = List(
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Create a Spark cluster (asynchronous); the name is the caller's."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "initializeSparkCluster"
          resourceNameTemplate = "[{{requestBody.name}}]"
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Get the Spark cluster by name, including lifecycle status."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "List"
        effect = Stateless
        idempotent = true
        doc = "List the workspace's Spark clusters."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSparkClusters"
          resourceNameTemplate = "[]"
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Decommission the Spark cluster (asynchronous): driver, executors and the cluster service account."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSparkCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Configure"
        effect = Reversible
        idempotent = true
        doc = "Update the cluster's sizing (rolls the driver) or its auto-stop setting (no restart)."
        openApiMappings = List(
          new resources.OpenApiMapping {
            operationId = "configureSparkCluster"
            resourceNameTemplate = "[{{parameters.name}}]"
          },
          new resources.OpenApiMapping {
            operationId = "configureSparkClusterAutoStop"
            resourceNameTemplate = "[{{parameters.name}}]"
          }
        )
      },
      new resources.Action {
        name = "Stop"
        effect = Reversible
        idempotent = false
        doc = "Stop the cluster: the driver goes to zero replicas and its pods stop; start it again later."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "stopSparkCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Start"
        effect = Reversible
        idempotent = false
        doc = "Start a stopped cluster (asynchronous)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "startSparkCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetEndpoints"
        effect = Stateless
        idempotent = true
        doc = "Spark Connect URL, proxied Spark UI path and the cluster's service account."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkClusterEndpoints"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetInstances"
        effect = Stateless
        idempotent = true
        doc = "Status of the cluster's driver and executor pods."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkClusterInstances"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetConnectionDetails"
        effect = Stateless
        idempotent = true
        doc = "Spark Connect host/port — used by the SQL proxy to connect."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkClusterConnectionDetails"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetInstanceLogs"
        effect = Stateless
        idempotent = true
        doc = "Tail of one driver/executor pod's logs (debugging aid)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkClusterInstanceLogs"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      }
    )
  })
}

// ---------------------------------------------------------------------------
// SparkApplication (workspace-scoped): a Spark application (JAR or PySpark) whose files live in a
// Tangram folder owned by this resource and whose runs execute as its service account (Kubernetes
// Jobs running `spark-submit` as their own driver). The run-files endpoint is called by run pods only
// and is not an action.
// ---------------------------------------------------------------------------

SparkApplication = new resources.ResourceTypeDefinition {
  name = "SparkApplication"
  doc  = "Spark application (JAR or PySpark): uploaded files, on-demand Kubernetes Job runs, logs"
  activeVersion = "v1"
  scopeType = resources.WORKSPACE_TYPE
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"; served = true
    // Grantable per-application roles: maintainer (code + runs) / runner (runs only) / viewer; no owner preset —
    // creating and deleting applications stay with the workspace admin.
    presetRoles = List(
      new resources.Role {
        name = "maintainer"
        permissions = List(
          "Get", "List", "Update", "UpdateLib", "ListLib", "ReadLib", "DeleteLib", "DeleteLibVersion",
          "Run", "ListRuns", "GetRunStats", "CancelRun", "GetRunLogs"
        )
        description = "Edit settings, upload and remove files, submit and cancel runs, read logs. Cannot delete the application."
      },
      new resources.Role {
        name = "runner"
        permissions = List("Get", "List", "ListLib", "ReadLib", "Run", "ListRuns", "GetRunStats", "CancelRun", "GetRunLogs")
        description = "Submit, cancel and follow runs of the application as it is. Cannot change its files."
      },
      new resources.Role {
        name = "viewer"
        permissions = List("Get", "List", "ListLib", "ReadLib", "ListRuns", "GetRunStats", "GetRunLogs")
        description = "Read-only — see the application, its files, runs and logs."
      }
    )
    actions = List(
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Create a Spark application (folder + service account)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "createSparkApplication"
          resourceNameTemplate = "[{{requestBody.name}}]"
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Get an application or one of its runs."
        openApiMappings = List(
          new resources.OpenApiMapping {
            operationId = "getSparkApplication"
            resourceNameTemplate = "[{{parameters.app}}]"
          },
          new resources.OpenApiMapping {
            operationId = "getSparkApplicationRun"
            resourceNameTemplate = "[{{parameters.app}}]"
          },
          new resources.OpenApiMapping {
            operationId = "getSparkApplicationRunStatus"
            resourceNameTemplate = "[{{parameters.app}}]"
          },
          new resources.OpenApiMapping {
            operationId = "getSparkApplicationRunSummary"
            resourceNameTemplate = "[{{parameters.app}}]"
          }
        )
      },
      new resources.Action {
        name = "List"
        effect = Stateless
        idempotent = true
        doc = "List applications."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSparkApplications"
          resourceNameTemplate = "[]"
        }
      },
      new resources.Action {
        name = "Update"
        effect = Reversible
        idempotent = true
        doc = "Replace the application's settings (entry point, sizing, Spark settings, env, service-account token); the next run uses them."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "updateSparkApplication"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete an application, its files and its service account."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSparkApplication"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "UpdateLib"
        effect = Reversible
        idempotent = false
        doc = "Upload a new version of an application file."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "uploadSparkApplicationLib"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "ListLib"
        effect = Stateless
        idempotent = true
        doc = "List the application's uploaded files."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSparkApplicationLibs"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "ReadLib"
        effect = Stateless
        idempotent = true
        doc = "Read the content of an application's text file (source code, config) for preview."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkApplicationLibContent"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "DeleteLib"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete every version of an application file."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSparkApplicationLib"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "DeleteLibVersion"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete one version of an application file."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSparkApplicationLibVersion"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "Run"
        effect = Reversible
        idempotent = false
        doc = "Submit a run of the application as a Kubernetes Job."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "runSparkApplication"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "ListRuns"
        effect = Stateless
        idempotent = true
        doc = "List runs of the application."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSparkApplicationRuns"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "GetRunStats"
        effect = Stateless
        idempotent = true
        doc = "Run counts by status."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkApplicationRunStats"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "CancelRun"
        effect = Reversible
        idempotent = true
        doc = "Cancel a pending or running run."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "cancelSparkApplicationRun"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "GetRunLogs"
        effect = Stateless
        idempotent = true
        doc = "Logs of a run's pods."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSparkApplicationRunLogs"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      }
    )
  })
}

types: List<resources.ResourceTypeDefinition> = List(SparkCluster, SparkApplication)
