import "@tangram-app-manifest/deployment.pkl" as deployment

// Auxiliary Helm chart deployed alongside the spark-operator-service component
// (see components.pkl). Quickwit indexes/serves Spark run logs written to the
// app's object-storage bucket. Helm values live in helm_chart_values.pkl, which
// the platform evaluates at deploy time with infra + deployment context injected.

charts: List<deployment.HelmChart> = List(
  new deployment.HelmChart {
    repo      = "https://helm.quickwit.io"
    fullName  = "quickwit/quickwit"
    version   = "1.18.0"
    components = List()
  }
)
