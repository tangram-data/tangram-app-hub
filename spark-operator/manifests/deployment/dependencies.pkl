import "@tangram-app-manifest/infra.pkl" as infra

// App state (the cluster record) lives in a platform-managed PostgreSQL database.
databaseClaim: infra.PostgresqlDatabaseClaim = new {
  resourceName = "db"
}

// Application files (uploaded libs) live in Tangram folders on this bucket.
bucketClaim: infra.StorageBucketClaim = new {
  resourceName = "storageBucket"
}
