import "@tangram-app-manifest/ui.pkl" as ui

logo = "static/spark.svg"

uiPattern = new ui.UriPattern {
  pattern = ".*"
}

deployment: ui.UIDeployment = new {
  mode = "Proxy"
  uriPatterns = List(uiPattern)
}

resourceTypeIcons {
  ["SparkCluster"] = "static/spark.svg"
  ["SparkApplication"] = "static/spark.svg"
}

resourceTypeUri {
  ["SparkCluster"] = "/clusters/{{names[1]}}"
  ["SparkApplication"] = "/applications/{{names[1]}}"
}
