import "@tangram-app-manifest/api.pkl" as api

// The concrete Kubernetes Service inside the App's derived installation
// namespace that implements this API (produced by the report-server
// component's AppComponentServiceSpec).
backend: api.ServiceBackend = new api.ServiceBackend {
  serviceName = "report-server"
  port = 8081
}

authMode    = "Proxy"
apiSpecFile = "open_api.yml"
