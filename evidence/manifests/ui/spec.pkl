import "@tangram-app-manifest/ui.pkl" as ui

logo = "static/logo.svg"

resourceTypeIcons {
  ["Report"] = "static/logo.svg"
}

resourceTypeUri {
  ["Report"] = "/reports/{{names[1]}}"
}

reportUIPattern = new ui.UriPattern {
  pattern = "/reports/([^/]+).*"
}

deployment: ui.UIDeployment = new {
  mode = "Proxy"
  uriPatterns = List(reportUIPattern)
}
