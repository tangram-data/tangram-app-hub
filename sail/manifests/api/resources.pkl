import "@tangram-app-manifest/resources.pkl" as resources

local Stateless = resources.Effect.Stateless
local Reversible = resources.Effect.Reversible
local Irreversible = resources.Effect.Irreversible

// ---------------------------------------------------------------------------
// SailCluster (workspace-scoped). superType SQLEngine: the core server registers the cluster as a
// SQL engine and the SQL proxy fetches its Flight SQL endpoint through GetConnectionDetails.
// ---------------------------------------------------------------------------

SailCluster = new resources.ResourceTypeDefinition {
  name = "SailCluster"
  doc  = "Sail (LakeSail) engine cluster: one Flight SQL driver with on-demand workers"
  activeVersion = "v1"
  scopeType = resources.WORKSPACE_TYPE
  superType = resources.SQL_ENGINE_TYPE
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"; served = true; superTypeVersion = "v1"
    // Grantable per-cluster roles (same shape as the Iceberg app's maintainer / viewer; no owner preset —
    // initializing and decommissioning stay with the workspace admin).
    // `viewer` is what a SQL user needs: the proxy connects through GetConnectionDetails.
    presetRoles = List(
      new resources.Role {
        name = "maintainer"
        permissions = List(
          "Get", "List", "Configure", "Stop", "Start", "GetEndpoints", "GetInstances", "GetInstanceLogs", "GetConnectionDetails"
        )
        description = "Configure sizing and auto-stop, stop and start, inspect instances and logs. Cannot initialize or decommission the cluster."
      },
      new resources.Role {
        name = "viewer"
        permissions = List("Get", "List", "GetEndpoints", "GetInstances", "GetConnectionDetails")
        description = "Read-only — see the cluster, its endpoints and instances, and query it through the SQL proxy."
      }
    )
    actions = List(
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Create a Sail cluster (asynchronous); the name is the caller's. Idempotent with the idempotencyKey field."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "initializeSailCluster"
          resourceNameTemplate = "[{{requestBody.name}}]"
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Get the Sail cluster by name, including lifecycle status."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "List"
        effect = Stateless
        idempotent = true
        doc = "List the workspace's Sail clusters."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSailClusters"
          resourceNameTemplate = "[]"
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Decommission the Sail cluster (asynchronous): driver, workers, engine service account and SQL engine registration."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSailCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Configure"
        effect = Reversible
        idempotent = true
        doc = "Update the cluster's sizing (rolls the driver) or its auto-stop setting (no restart)."
        openApiMappings = List(
          new resources.OpenApiMapping {
            operationId = "configureSailCluster"
            resourceNameTemplate = "[{{parameters.name}}]"
          },
          new resources.OpenApiMapping {
            operationId = "configureSailClusterAutoStop"
            resourceNameTemplate = "[{{parameters.name}}]"
          }
        )
      },
      new resources.Action {
        name = "Stop"
        effect = Reversible
        idempotent = false
        doc = "Stop the cluster: the driver and its workers stop; start it again later."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "stopSailCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "Start"
        effect = Reversible
        idempotent = false
        doc = "Start a stopped cluster (asynchronous)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "startSailCluster"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetEndpoints"
        effect = Stateless
        idempotent = true
        doc = "Flight SQL endpoint, SQL engine FN and the engine's service account."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailClusterEndpoints"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetInstances"
        effect = Stateless
        idempotent = true
        doc = "Status of the cluster's driver and workers."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailClusterInstances"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetInstanceLogs"
        effect = Stateless
        idempotent = true
        doc = "Tail of one driver or worker's logs (debugging aid)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailClusterInstanceLogs"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      },
      new resources.Action {
        name = "GetConnectionDetails"
        effect = Stateless
        idempotent = true
        doc = "Flight SQL host/port — used by the SQL proxy to connect."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailClusterConnectionDetails"
          resourceNameTemplate = "[{{parameters.name}}]"
        }
      }
    )
  })
}

// ---------------------------------------------------------------------------
// SailApplication (workspace-scoped): a PySpark application whose files live in a Tangram folder
// owned by this resource and whose runs execute as its service account (runs execute
// `sail spark run`). The run-files endpoint is called by runs only and is not an action.
// ---------------------------------------------------------------------------

SailApplication = new resources.ResourceTypeDefinition {
  name = "SailApplication"
  doc  = "PySpark application run on Sail: uploaded files, on-demand runs, logs"
  activeVersion = "v1"
  scopeType = resources.WORKSPACE_TYPE
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"; served = true
    // Grantable per-application roles: maintainer (code + runs) / runner (runs only) / viewer; no owner preset —
    // creating and deleting applications stay with the workspace admin.
    presetRoles = List(
      new resources.Role {
        name = "maintainer"
        permissions = List(
          "Get", "List", "Update", "UpdateLib", "ListLib", "ReadLib", "DeleteLib", "DeleteLibVersion",
          "Run", "ListRuns", "GetRunStats", "CancelRun", "GetRunLogs"
        )
        description = "Edit settings, upload and remove files, submit and cancel runs, read logs. Cannot delete the application."
      },
      new resources.Role {
        name = "runner"
        permissions = List("Get", "List", "ListLib", "ReadLib", "Run", "ListRuns", "GetRunStats", "CancelRun", "GetRunLogs")
        description = "Submit, cancel and follow runs of the application as it is. Cannot change its files."
      },
      new resources.Role {
        name = "viewer"
        permissions = List("Get", "List", "ListLib", "ReadLib", "ListRuns", "GetRunStats", "GetRunLogs")
        description = "Read-only — see the application, its files, runs and logs."
      }
    )
    actions = List(
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Create a PySpark application (folder + service account)."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "createSailApplication"
          resourceNameTemplate = "[{{requestBody.name}}]"
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Get an application or one of its runs."
        openApiMappings = List(
          new resources.OpenApiMapping {
            operationId = "getSailApplication"
            resourceNameTemplate = "[{{parameters.app}}]"
          },
          new resources.OpenApiMapping {
            operationId = "getSailApplicationRun"
            resourceNameTemplate = "[{{parameters.app}}]"
          },
          new resources.OpenApiMapping {
            operationId = "getSailApplicationRunStatus"
            resourceNameTemplate = "[{{parameters.app}}]"
          }
        )
      },
      new resources.Action {
        name = "List"
        effect = Stateless
        idempotent = true
        doc = "List applications."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSailApplications"
          resourceNameTemplate = "[]"
        }
      },
      new resources.Action {
        name = "Update"
        effect = Reversible
        idempotent = true
        doc = "Replace the application's settings (entry point, sizing, env, notifications, restarts); the next run uses them."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "updateSailApplication"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete an application, its files and its service account."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSailApplication"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "UpdateLib"
        effect = Reversible
        idempotent = false
        doc = "Upload a new version of an application file."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "uploadSailApplicationLib"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "ListLib"
        effect = Stateless
        idempotent = true
        doc = "List the application's uploaded files."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSailApplicationLibs"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "ReadLib"
        effect = Stateless
        idempotent = true
        doc = "Read the content of an application's text file (source code, config) for preview."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailApplicationLibContent"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "DeleteLib"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete every version of an application file."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSailApplicationLib"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "DeleteLibVersion"
        effect = Irreversible
        idempotent = true
        requiresConfirmation = true
        doc = "Delete one version of an application file."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "deleteSailApplicationLibVersion"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "Run"
        effect = Reversible
        idempotent = false
        doc = "Submit a run of the application."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "runSailApplication"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "ListRuns"
        effect = Stateless
        idempotent = true
        doc = "List runs of the application."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listSailApplicationRuns"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "GetRunStats"
        effect = Stateless
        idempotent = true
        doc = "Run counts by status."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailApplicationRunStats"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "CancelRun"
        effect = Reversible
        idempotent = true
        doc = "Cancel a pending or running run."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "cancelSailApplicationRun"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      },
      new resources.Action {
        name = "GetRunLogs"
        effect = Stateless
        idempotent = true
        doc = "Logs of a run's driver and workers."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getSailApplicationRunLogs"
          resourceNameTemplate = "[{{parameters.app}}]"
        }
      }
    )
  })
}

types: List<resources.ResourceTypeDefinition> = List(SailCluster, SailApplication)
