manifestSpecVersion = "v1"
group = "com.microsoft"
name = "teams"
version = "0.1.0"
appType = "Connector"
providerWebsite = "https://learn.microsoft.com/graph/api/resources/teams-api-overview"
category = "communication"
tags = List("microsoft", "teams", "chat", "messaging", "graph", "oauth")
description = "Microsoft Teams connector: browse teams and channels, post to channels, and read and send chat messages via Microsoft Graph. No admin consent needed; reading channel messages is in teams-channels."
readme      = read("README.md").text
