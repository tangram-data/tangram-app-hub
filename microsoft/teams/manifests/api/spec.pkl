import "@tangram-app-manifest/connector.pkl" as connector
import "@tangram-app-manifest/oauth.pkl" as oauthTypes

// Microsoft Teams connector API spec. All Microsoft 365 APIs are served from
// the single Microsoft Graph host; teams/chats live under /v1.0/me/* and
// /v1.0/teams/*.
endpoint = "https://graph.microsoft.com"
endpointOverridable = false
endpointRequired = false
endpointHostAllowlist = List("graph.microsoft.com")

apiSpecFile = "open_api.yml"

auth = new connector.ConnectorAuth {
  httpHeaders = Map (
    "Authorization",
    new connector.HeaderTemplate { template = "Bearer {{oauth.accessToken}}" }
  )
}

oauth = new oauthTypes.OAuth2AuthCode {
  authorizationUrl = "https://login.microsoftonline.com/organizations/oauth2/v2.0/authorize"
  tokenUrl = "https://login.microsoftonline.com/organizations/oauth2/v2.0/token"
  // All user-consentable (no admin consent): Team/Channel.ReadBasic.All for
  // browsing, ChannelMessage.Send to post, Chat.Read + ChatMessage.Send for
  // 1:1/group chats. Reading channel messages needs admin-consented
  // ChannelMessage.Read.All, so it lives in the separate teams-channels connector.
  // offline_access makes Entra issue a refresh token.
  scopes = List(
    "https://graph.microsoft.com/Team.ReadBasic.All",
    "https://graph.microsoft.com/Channel.ReadBasic.All",
    "https://graph.microsoft.com/ChannelMessage.Send",
    "https://graph.microsoft.com/Chat.Read",
    "https://graph.microsoft.com/ChatMessage.Send",
    "offline_access"
  )
  clientIdSecret = "microsoftClientId"
  clientSecretSecret = "microsoftClientSecret"
  callbackPath = "/api/core/v1/connector-oauth/callback/com.microsoft/teams"
  tokenAuthMethod = "ClientSecretPost"
  pkce = true
  refreshWindowSeconds = 600
  connectionScope = new oauthTypes.SelectableScope {
    default = "PerUser"
    allowedAtInstall = List("PerUser", "WorkspaceShared")
  }
}
