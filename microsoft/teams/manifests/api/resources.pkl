import "@tangram-app-manifest/resources.pkl" as resources

types: List<resources.ResourceTypeDefinition> = List(
  new resources.ResourceTypeDefinition {
    name = "Team"
    activeVersion = "v1"
    doc = "A Microsoft Teams team the connected user is a member of."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List the teams the connected user has joined; team ids scope channel and message operations."
          openApiMapping = new resources.OpenApiMapping { operationId = "listTeams" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "List joined teams through the Teams connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Channel"
    activeVersion = "v1"
    doc = "A channel within a team."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List a team's channels; channel ids scope message listing and sending."
          openApiMapping = new resources.OpenApiMapping { operationId = "listChannels" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "List team channels through the Teams connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "ChannelMessage"
    activeVersion = "v1"
    doc = "A message posted to a team channel."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List a channel's messages, newest first; $top for page size, $expand=replies for threads, page via @odata.nextLink."
          openApiMapping = new resources.OpenApiMapping { operationId = "listChannelMessages" }
        },
        new resources.Action {
          name = "Send"
          privilege = "Create"
          effect = "Irreversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Post a new message to a channel; body contentType is text or html."
          openApiMapping = new resources.OpenApiMapping { operationId = "sendChannelMessage" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read", "Create")
        description = "Read and send channel messages through the Teams connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Chat"
    activeVersion = "v1"
    doc = "A 1:1 or group chat the connected user participates in."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List the connected user's chats; $expand=members reveals who each 1:1/group chat is with, $top for page size."
          openApiMapping = new resources.OpenApiMapping { operationId = "listChats" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "List chats through the Teams connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "ChatMessage"
    activeVersion = "v1"
    doc = "A message in a 1:1 or group chat."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List a chat's messages, newest first; $top for page size, page via @odata.nextLink."
          openApiMapping = new resources.OpenApiMapping { operationId = "listChatMessages" }
        },
        new resources.Action {
          name = "Send"
          privilege = "Create"
          effect = "Irreversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Send a message to a 1:1 or group chat; body contentType is text or html."
          openApiMapping = new resources.OpenApiMapping { operationId = "sendChatMessage" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read", "Create")
        description = "Read and send chat messages through the Teams connector."
      })
    })
  }
)
