import "@tangram-app-manifest/ui.pkl" as ui

logo = "static/outlook.png"

deployment: ui.UIDeployment = new {
  mode = "None"
}

components: Listing<ui.AppUIComponentSpec> = new Listing {
  new ui.AppUIComponentSpec {
    name = "mail-viewer"
    kind = "sandboxed"
    entry = "components/mail-viewer/mail-viewer.tsx"
    spec = new ui.UIComponentContract {
      title = "Mail viewer"
      description = "Render an Outlook message's headers, body, and attachments by message id."
      inputs {
        type = "object"
        required {
          "messageId"
        }
        properties {
          ["messageId"] = new Dynamic {
            type = "string"
            description = "Outlook message id, e.g. from outlook_list_message."
          }
        }
      }
      outputs {
        new ui.UIComponentOutput {
          name = "reply"
          payload {
            type = "object"
            properties {
              ["to"] = new Dynamic { type = "string" }
              ["subject"] = new Dynamic { type = "string" }
              ["conversationId"] = new Dynamic { type = "string" }
            }
          }
        }
      }
    }
    surfaces { "chat"; "app-page" }
  }
  new ui.AppUIComponentSpec {
    name = "mail-composer"
    kind = "sandboxed"
    entry = "components/mail-composer/mail-composer.tsx"
    spec = new ui.UIComponentContract {
      title = "Mail composer"
      description = "Compose and send an email as the connected Outlook account; fields are editable before sending."
      inputs {
        type = "object"
        properties {
          ["to"] = new Dynamic {
            type = "string"
            description = "Recipient addresses, comma-separated."
          }
          ["cc"] = new Dynamic { type = "string" }
          ["subject"] = new Dynamic { type = "string" }
          ["body"] = new Dynamic {
            type = "string"
            description = "Plain-text message body; the user can edit it before sending."
          }
        }
      }
      outputs {
        new ui.UIComponentOutput {
          name = "sent"
          payload {
            type = "object"
            properties {
              ["to"] = new Dynamic { type = "string" }
              ["subject"] = new Dynamic { type = "string" }
            }
          }
        }
      }
    }
    surfaces { "chat"; "app-page" }
  }
  new ui.AppUIComponentSpec {
    name = "event-list"
    kind = "sandboxed"
    entry = "components/event-list/event-list.tsx"
    spec = new ui.UIComponentContract {
      title = "Event list"
      description = "Agenda view of Outlook calendar events for a calendar and time window; rows expand to show details."
      inputs {
        type = "object"
        properties {
          ["calendarId"] = new Dynamic {
            type = "string"
            description = "Calendar id from outlook_list_calendar; defaults to the account's default calendar (isDefaultCalendar=true)."
          }
          ["startDateTime"] = new Dynamic {
            type = "string"
            description = "ISO 8601 window start (calendarView requires a window); defaults to the start of today."
          }
          ["endDateTime"] = new Dynamic {
            type = "string"
            description = "ISO 8601 window end; defaults to 30 days after the start."
          }
          ["q"] = new Dynamic {
            type = "string"
            description = "Subject search text, applied as an OData contains(subject, ...) filter."
          }
          ["top"] = new Dynamic {
            type = "number"
            description = "Events per page (default 50)."
          }
        }
      }
      outputs {
        new ui.UIComponentOutput {
          name = "select"
          payload {
            type = "object"
            properties {
              ["calendarId"] = new Dynamic { type = "string" }
              ["eventId"] = new Dynamic { type = "string" }
              ["subject"] = new Dynamic { type = "string" }
              ["start"] = new Dynamic { type = "string" }
              ["end"] = new Dynamic { type = "string" }
              ["timeZone"] = new Dynamic {
                type = "string"
                description = "Zone the start/end wall clocks are in (calendarView returns UTC); empty for all-day."
              }
            }
          }
        }
      }
    }
    surfaces { "chat"; "app-page" }
  }
  new ui.AppUIComponentSpec {
    name = "event-composer"
    kind = "sandboxed"
    entry = "components/event-composer/event-composer.tsx"
    spec = new ui.UIComponentContract {
      title = "Event composer"
      description = "Create or edit an Outlook calendar event; an agent prefills the fields and the user edits before saving."
      inputs {
        type = "object"
        properties {
          ["calendarId"] = new Dynamic {
            type = "string"
            description = "Target calendar id (required to create — Graph has no default-calendar alias); ignored when editing."
          }
          ["eventId"] = new Dynamic {
            type = "string"
            description = "Set to edit an existing event instead of creating one."
          }
          ["subject"] = new Dynamic { type = "string"; description = "Event title." }
          ["body"] = new Dynamic { type = "string"; description = "Plain-text description." }
          ["location"] = new Dynamic { type = "string" }
          ["start"] = new Dynamic {
            type = "string"
            description = "Start time, ISO 8601 wall clock without offset (or YYYY-MM-DD for all-day)."
          }
          ["end"] = new Dynamic {
            type = "string"
            description = "End time, ISO 8601 wall clock without offset (or inclusive YYYY-MM-DD for all-day)."
          }
          ["allDay"] = new Dynamic { type = "boolean" }
          ["timeZone"] = new Dynamic {
            type = "string"
            description = "IANA/Windows zone the start/end wall clocks are in (e.g. UTC from event-list's select); defaults to the viewer's zone."
          }
          ["attendees"] = new Dynamic {
            type = "string"
            description = "Attendee emails, comma-separated."
          }
          ["teams"] = new Dynamic {
            type = "boolean"
            description = "Attach a Microsoft Teams meeting on create (ignored when editing)."
          }
        }
      }
      outputs {
        new ui.UIComponentOutput {
          name = "saved"
          payload {
            type = "object"
            properties {
              ["id"] = new Dynamic { type = "string" }
              ["webLink"] = new Dynamic { type = "string" }
              ["joinUrl"] = new Dynamic { type = "string" }
            }
          }
        }
      }
    }
    surfaces { "chat"; "app-page" }
  }
}
