        new resources.Action {
          name = "Query"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Query free/busy availability for one or more SMTP addresses over a startTime/endTime window (getSchedule) — use to find open slots before scheduling."
          openApiMapping = new resources.OpenApiMapping { operationId = "querySchedule" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "Check availability through the Outlook connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Person"
    activeVersion = "v1"
    doc = "A person relevant to the connected user (contact, colleague, or frequent correspondent)."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Find people by name or email ($search) ranked by relevance to the user — use to resolve a name to an email address before sending or inviting."
          openApiMapping = new resources.OpenApiMapping { operationId = "listPeople" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "Look up people through the Outlook connector."
      })
    })
  }
