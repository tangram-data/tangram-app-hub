import "@tangram-app-manifest/resources.pkl" as resources

types: List<resources.ResourceTypeDefinition> = List(
  new resources.ResourceTypeDefinition {
    name = "Message"
    activeVersion = "v1"
    doc = "An email message in the connected account's mailbox."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List or search messages across the mailbox; $search (value wrapped in double quotes) for free-text/KQL, $filter for structured queries, $top + @odata.nextLink for paging. Use ListInFolder to scope to one folder."
          openApiMapping = new resources.OpenApiMapping { operationId = "listMessages" }
        },
        new resources.Action {
          name = "ListInFolder"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List or search messages in one mail folder; folderId is a MailFolder.List id or a well-known name (inbox, sentitems, drafts, deleteditems, archive). Same $search/$filter/$select/$top paging as List."
          openApiMapping = new resources.OpenApiMapping { operationId = "listFolderMessages" }
        },
        new resources.Action {
          name = "Get"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Fetch a single message by id, including subject, sender, recipients, and body."
          openApiMapping = new resources.OpenApiMapping { operationId = "getMessage" }
        },
        new resources.Action {
          name = "Send"
          privilege = "Create"
          effect = "Irreversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Send an email immediately via sendMail; a copy lands in Sent Items unless saveToSentItems=false."
          openApiMapping = new resources.OpenApiMapping { operationId = "sendMessage" }
        },
        new resources.Action {
          name = "Reply"
          privilege = "Create"
          effect = "Irreversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Reply to a message's sender, threaded on the conversation; comment is the reply text above the quoted original, message.toRecipients/ccRecipients add recipients."
          openApiMapping = new resources.OpenApiMapping { operationId = "replyMessage" }
        },
        new resources.Action {
          name = "ReplyAll"
          privilege = "Create"
          effect = "Irreversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Reply to the sender and all recipients of a message, threaded on the conversation; same body as Reply."
          openApiMapping = new resources.OpenApiMapping { operationId = "replyAllMessage" }
        },
        new resources.Action {
          name = "Forward"
          privilege = "Create"
          effect = "Irreversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Forward a message (with its attachments) to toRecipients (required); comment is placed above the forwarded content."
          openApiMapping = new resources.OpenApiMapping { operationId = "forwardMessage" }
        },
        new resources.Action {
          name = "SendDraft"
          privilege = "Create"
          effect = "Irreversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Send an existing draft by id (e.g. one made by Draft.Create); it moves to Sent Items."
          openApiMapping = new resources.OpenApiMapping { operationId = "sendDraft" }
        },
        new resources.Action {
          name = "Update"
          privilege = "Update"
          effect = "Reversible"
          idempotent = true
          doc = "Mark a message read/unread (isRead), replace its categories, or set its follow-up flag (flag.flagStatus flagged/complete/notFlagged); only fields present change."
          openApiMapping = new resources.OpenApiMapping { operationId = "updateMessage" }
        },
        new resources.Action {
          name = "Move"
          privilege = "Update"
          effect = "Reversible"
          idempotent = false
          doc = "Move a message to another folder (destinationId = MailFolder.List id or well-known name like archive, deleteditems, inbox); the moved message gets a new id, returned in the response."
          openApiMapping = new resources.OpenApiMapping { operationId = "moveMessage" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read", "Create", "Update")
        description = "Read, search, send, reply to, and organize mail through the Outlook connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Draft"
    activeVersion = "v1"
    doc = "A draft message in the connected account's mailbox."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "Create"
          privilege = "Create"
          effect = "Reversible"
          idempotent = false
          doc = "Create a draft in the Drafts folder for the user to review and send from Outlook."
          openApiMapping = new resources.OpenApiMapping { operationId = "createDraft" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Create")
        description = "Create mail drafts through the Outlook connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Attachment"
    activeVersion = "v1"
    doc = "A file attached to a message in the connected account's mailbox."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List a message's attachments. Pass $select=id,name,contentType,size,isInline to skip the base64 contentBytes (up to ~3MB each); fetch content with Get."
          openApiMapping = new resources.OpenApiMapping { operationId = "listAttachments" }
        },
        new resources.Action {
          name = "Get"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Fetch one attachment by message id and attachment id, including its base64 contentBytes."
          openApiMapping = new resources.OpenApiMapping { operationId = "getAttachment" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "Read mail attachments through the Outlook connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "MailFolder"
    activeVersion = "v1"
    doc = "A mail folder (Inbox, Sent Items, custom folders) in the connected account's mailbox."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List mail folders; folder ids (or well-known names like inbox) scope message listing via Message.ListInFolder."
          openApiMapping = new resources.OpenApiMapping { operationId = "listMailFolders" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "List mail folders through the Outlook connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Calendar"
    activeVersion = "v1"
    doc = "A calendar in the connected account's mailbox."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List the account's calendars; ids feed the calendarId of event operations, and isDefaultCalendar=true marks the user's default calendar."
          openApiMapping = new resources.OpenApiMapping { operationId = "listCalendars" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read")
        description = "List calendars through the Outlook connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Event"
    activeVersion = "v1"
    doc = "An event on one of the connected account's calendars."
    versions = List(new resources.ResourceTypeVersion {
      version = "v1"
      served = true
      actions = List(
        new resources.Action {
          name = "List"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "List events in a required startDateTime/endDateTime window via calendarView, which expands recurring events into instances (Graph's analog of Google's singleEvents)."
          openApiMapping = new resources.OpenApiMapping { operationId = "listEvents" }
        },
        new resources.Action {
          name = "Get"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Fetch a single event by id, including times, attendees, body, and online-meeting link."
          openApiMapping = new resources.OpenApiMapping { operationId = "getEvent" }
        },
        new resources.Action {
          name = "Create"
          privilege = "Create"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Create an event on a calendar. start/end take {dateTime,timeZone} (dateTime has no offset — timeZone carries the zone); isOnlineMeeting + onlineMeetingProvider=teamsForBusiness attaches a Teams link."
          openApiMapping = new resources.OpenApiMapping { operationId = "createEvent" }
        },
        new resources.Action {
          name = "Update"
          privilege = "Update"
          effect = "Reversible"
          idempotent = false
          requiresConfirmation = true
          doc = "Patch fields of an existing event (PATCH semantics — only the fields present in the body change). Graph emails attendees about the change automatically."
          openApiMapping = new resources.OpenApiMapping { operationId = "updateEvent" }
        },
        new resources.Action {
          name = "Delete"
          privilege = "Delete"
          effect = "Irreversible"
          idempotent = true
          requiresConfirmation = true
          doc = "Delete an event by id; attendees receive a cancellation."
          openApiMapping = new resources.OpenApiMapping { operationId = "deleteEvent" }
        },
        new resources.Action {
          name = "Accept"
          privilege = "Update"
          effect = "Reversible"
          idempotent = true
          requiresConfirmation = true
          doc = "Accept a meeting invitation by event id; optional comment to the organizer, sendResponse=false to accept silently."
          openApiMapping = new resources.OpenApiMapping { operationId = "acceptEvent" }
        },
        new resources.Action {
          name = "Decline"
          privilege = "Update"
          effect = "Reversible"
          idempotent = true
          requiresConfirmation = true
          doc = "Decline a meeting invitation by event id; optional comment to the organizer, sendResponse=false to decline silently."
          openApiMapping = new resources.OpenApiMapping { operationId = "declineEvent" }
        },
        new resources.Action {
          name = "TentativelyAccept"
          privilege = "Update"
          effect = "Reversible"
          idempotent = true
          requiresConfirmation = true
          doc = "Tentatively accept a meeting invitation by event id; optional comment, sendResponse=false to respond silently."
          openApiMapping = new resources.OpenApiMapping { operationId = "tentativelyAcceptEvent" }
        },
        new resources.Action {
          name = "FindMeetingTimes"
          privilege = "Read"
          effect = "Stateless"
          idempotent = true
          doc = "Suggest meeting slots that fit the attendees' availability within timeConstraint.timeSlots for a meetingDuration (ISO 8601, e.g. PT30M); work/school accounts only."
          openApiMapping = new resources.OpenApiMapping { operationId = "findMeetingTimes" }
        }
      )
      presetRoles = List(new resources.Role {
        name = "user"
        permissions = List("Read", "Create", "Update", "Delete")
        description = "Read and manage events through the Outlook connector."
      })
    })
  },
  new resources.ResourceTypeDefinition {
    name = "Schedule"
    activeVersion = "v1"
    doc = "Free/busy availability information for users and resources."
