manifestSpecVersion = "v1"
group = "com.microsoft"
name = "sharepoint"
version = "0.1.1"
appType = "Connector"
providerWebsite = "https://learn.microsoft.com/graph/api/resources/sharepoint"
category = "productivity"
tags = List("microsoft", "sharepoint", "sites", "lists", "documents", "graph", "oauth")
description = "SharePoint connector: search sites and content, browse lists and document libraries, read files, and read/create/update list items via Microsoft Graph."
readme      = read("README.md").text
