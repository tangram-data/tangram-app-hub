local Stateless = resources.Effect.Stateless
local Reversible = resources.Effect.Reversible
local Irreversible = resources.Effect.Irreversible

Instance = new resources.ResourceTypeDefinition {
  name = "Instance"
  doc = "Duckling Instance"
  activeVersion = "v2"
  superType = resources.SQL_ENGINE_TYPE
  scopeType = resources.WORKSPACE_TYPE
  versions = List(new resources.ResourceTypeVersion {
    version = "v2"
    served = true
    superTypeVersion = "v1"
    actions = List(
      new resources.Action {
        name = "List"
        effect = Stateless
        idempotent = true
        doc = "List Duckling instances."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "listDucklingInstances"
        }
      },
      new resources.Action {
        name = "Create"
        effect = Reversible
        idempotent = false
        doc = "Create a Duckling instance. Idempotent with idempotencyKey; returns the instance."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "createDucklingInstance"
          resourceName = List(new resources.BodyField { path = "instanceName" })
        }
      },
      new resources.Action {
        name = "Get"
        effect = Stateless
        idempotent = true
        doc = "Get a Duckling instance."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getDucklingInstance"
          resourceName = List(new resources.PathParam { name = "instance" })
        }
      },
      new resources.Action {
        name = "Update"
        effect = Reversible
        idempotent = false
        doc = "Update a Duckling instance."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "updateDucklingInstance"
          resourceName = List(new resources.PathParam { name = "instance" })
        }
      },
      new resources.Action {
        name = "Start"
        effect = Reversible
        idempotent = false
        doc = "Start a Duckling instance."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "startDucklingInstance"
          resourceName = List(new resources.PathParam { name = "instance" })
        }
      },
      new resources.Action {
        name = "Stop"
        effect = Reversible
        idempotent = true
        doc = "Stop a Duckling instance."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "stopDucklingInstance"
          resourceName = List(new resources.PathParam { name = "instance" })
        }
      },
      new resources.Action {
        name = "Delete"
        effect = Irreversible
        idempotent = true
        doc = "Delete a Duckling instance."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "removeDucklingInstance"
          resourceName = List(new resources.PathParam { name = "instance" })
        }
      },
      new resources.Action {
        name = "GetStatus"
        effect = Stateless
        idempotent = true
        skipAudit = true
        doc = "Get the status of a Duckling instance."
        openApiMapping = new resources.OpenApiMapping {
          operationId = "getInstanceStatus"
          resourceName = List(new resources.PathParam { name = "instance" })
        }
      }
    )
  })
}

DuckLake = new resources.ResourceTypeDefinition {
