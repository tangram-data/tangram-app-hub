manifestSpecVersion = "v1"
group = "com.pagerduty"
name = "pagerduty"
version = "0.1.0"
appType = "Connector"
providerWebsite = "https://developer.pagerduty.com/api-reference/"
category = "developer"
tags = List("pagerduty", "incidents", "on-call", "alerting", "sre", "oauth")
