import "@tangram-app-manifest/manifest.pkl" as manifest

secrets: List<manifest.ConfigField> = List(
  new manifest.ConfigField {
    name        = "stripeApiKey"
    required    = true
    description = "A Stripe restricted key (rk_live_… or rk_test_…): Read on the resources you want visible, Write only on those the agent may change (see README). Every call runs with this key; never use a secret key (sk_…)."
    example     = "rk_live_…"
  }
)
