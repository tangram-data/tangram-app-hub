    reader("List", "listSubscriptions", "List subscriptions, newest first. Filter by customer, price, status and created[gte]/created[lte] (UNIX seconds); page with starting_after = the last id while has_more. Amounts are in the smallest currency unit. expand[] inlines related objects (e.g. data.customer)."),
    reader("Get", "getSubscription", "Retrieve one subscription by id; expand[] inlines related objects.")
