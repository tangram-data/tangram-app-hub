import "@tangram-app-manifest/resources.pkl" as resources

// Stateless read bound to one operation.
local function reader(actionName: String, op: String, text: String) = new resources.Action {
  name = actionName
  privilege = "Read"
  effect = "Stateless"
  idempotent = true
  doc = text
  openApiMapping = new resources.OpenApiMapping { operationId = op }
}

local function readOnly(typeName: String, typeDoc: String, acts: List<resources.Action>) = new resources.ResourceTypeDefinition {
  name = typeName
  activeVersion = "v1"
  doc = typeDoc
  versions = List(new resources.ResourceTypeVersion {
    version = "v1"
    served = true
    actions = acts
    presetRoles = List(new resources.Role {
      name = "user"
      permissions = List("Read")
      description = "Read \(typeName) data through the Stripe connector."
    })
  })
}

types: List<resources.ResourceTypeDefinition> = List(
  readOnly("Balance", "The account's Stripe balance.", List(
    reader("Get", "getBalance", "Available and pending balance per currency (amounts in the smallest currency unit, e.g. cents). Cheapest connection check.")
  )),
  readOnly("Customer", "A customer: name, email, address, default payment method, balance.", List(
    reader("Search", "searchCustomers", "Search customers with Stripe search query syntax, e.g. email:'jo@acme.com', name~'acme', metadata['crm_id']:'123'. Fields: exact match field:'value', substring field~'val' (3+ chars), numeric > < =, AND/OR (not mixed), metadata['key']. Results can lag ~1 minute; page with page = next_page. Not available in India."),
    reader("List", "listCustomers", "List customers, newest first. Filter by email and created[gte]/created[lte] (UNIX seconds); page with starting_after = the last id while has_more. Amounts are in the smallest currency unit. expand[] inlines related objects (e.g. data.customer)."),
    reader("Get", "getCustomer", "Retrieve one customer by id; expand[] inlines related objects.")
  )),
  readOnly("PaymentIntent", "A payment attempt and its status (succeeded, requires_payment_method, canceled, ...).", List(
