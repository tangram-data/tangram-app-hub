    reader("List", "listInvoices", "List invoices, newest first. Filter by customer, subscription, status and created[gte]/created[lte] (UNIX seconds); page with starting_after = the last id while has_more. Amounts are in the smallest currency unit. expand[] inlines related objects (e.g. data.customer)."),
    reader("Get", "getInvoice", "Retrieve one invoice by id; expand[] inlines related objects.")
